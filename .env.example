# Copy to .env for local dev. On Hugging Face Spaces, set these as
# Settings -> Variables and secrets instead of committing a real .env.

# Required: protects /admin and /admin/export.* — generate your own with
# `python3 -c "import secrets; print(secrets.token_hex(24))"`
ADMIN_TOKEN=changeme-generate-a-long-random-token

# Optional
GEO_LOOKUP_ENABLED=true
GEO_CACHE_TTL_SECONDS=86400
DATA_DIR=data

# --- Deployment-only values below ---
# Not read by the app at runtime — used to push this project to your git
# repo / Hugging Face Space. Fill in your real .env (never this file).

GIT_REPO_URL=
HF_USERNAME=
HF_SPACE_NAME=
HF_TOKEN=
